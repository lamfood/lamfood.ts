generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  category    String
  image       String?
  available   Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /** Optional list of selectable add-ons (size, extra cheese, spiciness, ...).
   *  Stored as a JSON array of {name, price, default?} objects so we don't
   *  need a join table for a simple fixed-form menu item. */
  optionsJson String   @default("[]")

  /** Time-of-day availability window in HH:MM format (Tehran local time).
   *  When both are null, the item is available all day.
   *  When set, the item is only shown/available between these hours.
   *  Supports overnight windows (e.g. from=18:00, to=02:00). */
  availableFrom String?
  availableTo   String?

  /** Incremented each time a customer opens the item details dialog.
   *  Used for the "محبوب‌ترین" (most popular) sort + flame badges. */
  viewCount Int @default(0)

  @@index([category])
  @@index([featured])
}

/** Order status lifecycle. Mirrors the valuesh enum in `src/lib/types.ts`. */
enum OrderStatus {
  NEW
  SEEN
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

/**
 * A customer-submitted order. Created from the public basket checkout
 * (POST /api/orders) and managed from the admin Orders tab.
 *
 * `linesJson` stores a snapshot of the basket at submission time (id, name,
 * price, qty, image) so the order stays readable even if a MenuItem is later
 * edited or deleted. `customerName`/`note` are optional free-text fields
 * from the basket sheet.
 */
model Order {
  id           String      @id @default(cuid())
  /** Human-friendly short id shown to the customer and the admin
   *  (e.g. "LF-7K3X9"). Generated server-side; unique via @@index. */
  publicCode   String      @unique
  status       OrderStatus @default(NEW)
  customerName String      @default("")
  note         String      @default("")
  /** Snapshot of basket lines as JSON: [{id,name,price,qty,image?}, ...]. */
  linesJson    String
  /** Total price in «هزار تومان» units (sum of qty*price). */
  total        Int
  /** Originating IP for abuse triage (no PII). */
  customerIp   String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}